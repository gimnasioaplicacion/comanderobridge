{
  "appId": "online.comandero.bridge",
  "appName": "Comandero Bridge",
  "webDir": "www",
  "server": {
    "url": "https://bridge.comandero.online",
    "cleartext": false,
    "allowNavigation": ["*.comandero.online", "comandero.online"]
  },
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "limitsNavigationsToAppBoundDomains": false,
    "preferredContentMode": "mobile",
    "handleApplicationNotifications": false
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT"
    }
  },
  "android": {
    "allowMixedContent": true
  }
}
