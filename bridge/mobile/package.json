{
  "name": "comandero-bridge-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Comandero Bridge para iPad y Android (agente local de impresión)",
  "scripts": {
    "sync": "cap sync",
    "sync:ios": "cap sync ios && bash ios-permisos.sh",
    "sync:android": "cap sync android && bash android-preparar.sh",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "build:aab": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "capacitor-tcp-socket": "^7.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
